import "../../minepkl/build.pkl"

function namespaceof(location: String): String =
  location.trim().split(":").first

function pathof(location: String): String =
  location.trim().split(":").last

function fullpath(source, type, location) =
  "\(source)/\(type)/\(namespaceof(location))/\(pathof(location)).json"

function mapresources(source, type, map) = new Mapping<String, FileOutput> {
  for (location, val in map) {
    [fullpath(source, type, location)] {
      value = val; renderer = new JsonRenderer {}
    }
  }
}

function mcmeta(respack) = new {
  pack {
    pack_format = 48
    description = respack.getPropertyOrNull("description") ?? "Generated resources"
  }
}

output {
  files {
    for (source, pack in build.packs) {
      ...mapresources(source, "data", pack.getPropertyOrNull("data") ?? Map())
      ...mapresources(source, "assets", pack.getPropertyOrNull("assets") ?? Map())

      ["\(source)/pack.mcmeta"] {
        value = mcmeta(pack)
        renderer = new JsonRenderer {}
      }
    }
  }
}